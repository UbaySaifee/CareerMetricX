# ==============================================================================
# CareerMetricX — Environment Configuration Template
# Title: CareerMetricX — Evidence-Grounded Career Readiness & Interview Intelligence Platform
# Note: Copy this file to .env and configure values according to your environment.
# NEVER commit real credentials or secrets to source control.
# ==============================================================================

# Application Runtime Configuration
ENVIRONMENT=development
APP_NAME=CareerMetricX
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:80"]

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=careermetricx_dev
MONGODB_TEST_DB_NAME=careermetricx_test
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Security & Authentication (JWT)
# Generate a secure key in production using: openssl rand -hex 32
SECRET_KEY=careermetricx-insecure-dev-secret-key-replace-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Intelligence Provider Configuration
# Options: "deterministic" (local rule-based, default for offline/tests), "openai" (OpenAI-compatible endpoint)
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Document & File Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf","docx","txt"]
UPLOAD_DIR=./storage/uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Observability (Optional Sentry / Telemetry)
SENTRY_DSN=
ENABLE_METRICS=true

# Frontend Environment Variables (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=CareerMetricX
VITE_APP_TAGLINE=Measure your skills. Prove your readiness.
